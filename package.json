{
  "name": "@miquelt9/pc-ui",
  "version": "1.1.0",
  "description": "Retro Windows 9x-style Design System (CSS tokens, primitives, optional React components)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/miquelt9/pc-ui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pc-ui.css": "./src/pc-ui.css",
    "./tokens.css": "./src/tokens.css",
    "./primitives.css": "./src/primitives.css",
    "./style.css": "./src/pc-ui.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "bundle:css": "node scripts/bundle-css.mjs",
    "build": "npm run bundle:css && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
